    "end",
    "queue_wait_seconds",
    "eligible_wait_seconds",
    "duration_seconds",
    "req_mem",
    "alloc_cpus",
    "total_cpu_seconds",
    "cpu_efficiency_percent",
    "max_rss_kib",
    "max_rss_gib",
    "ave_disk_read_kib",
    "ave_disk_read_gib",
