def build_tasks(logical_rows: list[dict[str, str]], all_rows: list[dict[str, str]]) -> list[dict]:
    tasks = []
    for row in logical_rows:
        job_id = row["JobID"]
        submit = parse_datetime(row["Submit"])
        eligible = parse_datetime(row["Eligible"])
        start = parse_datetime(row["Start"])
        end = parse_datetime(row["End"])
        duration = parse_int(row["ElapsedRaw"])
        if duration is None and start is not None and end is not None:
            duration = max(0, int((end - start).total_seconds()))
        alloc_cpus = parse_int(row["AllocCPUS"])
        node_count = parse_int(row["NNodes"])
        if node_count is None and row["NodeList"] and not re.search(r"[\[, ]", row["NodeList"]):
            node_count = 1
        req_cpus = parse_int(row["ReqCPUS"])
        timelimit_minutes = parse_int(row["TimelimitRaw"])
        timelimit = timelimit_minutes * 60 if timelimit_minutes is not None else None
        resources = resource_values(job_id, all_rows)
        max_rss_kib = resources["max_rss_kib"]
        total_cpu = resources["total_cpu_seconds"]
        requested_mem_kib = requested_memory_kib(row["ReqMem"], alloc_cpus, node_count)
        allocated_mem_kib = allocated_memory_kib(row["AllocTRES"])
        memory_denominator = allocated_mem_kib or requested_mem_kib
        allocated_cpu_seconds = (
            duration * alloc_cpus
            if duration is not None and alloc_cpus is not None and alloc_cpus > 0
            else None
        )
        cpu_efficiency = (
            100 * total_cpu / allocated_cpu_seconds
            if total_cpu is not None and allocated_cpu_seconds
            else None
        )
        array_match = re.fullmatch(r"[0-9]+_([0-9]+)", job_id)
        tasks.append(
            {
                "job_id": job_id,
                "job_id_raw": row["JobIDRaw"],
                "array_task_id": int(array_match.group(1)) if array_match else "",
                "job_name": row["JobName"],
                "partition": row["Partition"],
                "account": row["Account"],
                "user": row["User"],
                "qos": row["QOS"],
                "state": clean_state(row["State"]),
                "exit_code": row["ExitCode"],
                "submit": row["Submit"],
                "eligible": row["Eligible"],
                "start": row["Start"],
                "end": row["End"],
                "queue_wait_seconds": (
                    (start - submit).total_seconds() if start is not None and submit is not None else None
                ),
                "pre_eligible_wait_seconds": (
                    (eligible - submit).total_seconds()
                    if eligible is not None and submit is not None
                    else None
                ),
                "eligible_wait_seconds": (
                    (start - eligible).total_seconds()
                    if start is not None and eligible is not None
                    else None
                ),
                "duration_seconds": duration,
                "timelimit_seconds": timelimit,
                "timelimit_utilization_percent": (
                    100 * duration / timelimit if duration is not None and timelimit else None
                ),
                "node_count": node_count,
                "req_cpus": req_cpus,
                "req_mem": row["ReqMem"],
                "req_tres": row["ReqTRES"],
                "alloc_tres": row["AllocTRES"],
                "requested_memory_gib": (
                    requested_mem_kib / 1024**2 if requested_mem_kib is not None else None
                ),
                "allocated_memory_gib": (
                    allocated_mem_kib / 1024**2 if allocated_mem_kib is not None else None
                ),
                "memory_peak_fraction_percent": (
                    100 * max_rss_kib / memory_denominator
                    if max_rss_kib is not None and memory_denominator
                    else None
                ),
                "alloc_cpus": alloc_cpus,
                "total_cpu_seconds": total_cpu,
                "average_cpu_used": (
                    total_cpu / duration if total_cpu is not None and duration else None
                ),
                "cpu_efficiency_percent": cpu_efficiency,
                "max_rss_kib": max_rss_kib,
                "max_rss_gib": max_rss_kib / 1024**2 if max_rss_kib is not None else None,
                "ave_disk_read_kib": resources["ave_disk_read_kib"],
                "ave_disk_read_gib": (
                    resources["ave_disk_read_kib"] / 1024**2
                    if resources["ave_disk_read_kib"] is not None
                    else None
                ),
                "ave_disk_write_kib": resources["ave_disk_write_kib"],
                "ave_disk_write_gib": (
                    resources["ave_disk_write_kib"] / 1024**2
                    if resources["ave_disk_write_kib"] is not None
                    else None
                ),
                "max_disk_read_kib": resources["max_disk_read_kib"],
                "max_disk_read_gib": (
                    resources["max_disk_read_kib"] / 1024**2
                    if resources["max_disk_read_kib"] is not None
                    else None
                ),
                "max_disk_write_kib": resources["max_disk_write_kib"],
                "max_disk_write_gib": (
                    resources["max_disk_write_kib"] / 1024**2
                    if resources["max_disk_write_kib"] is not None
                    else None
                ),
                "node_list": row["NodeList"],
                "_submit_dt": submit,
                "_start_dt": start,
                "_end_dt": end,
            }
        )
    return tasks


def build_profile(tasks: list[dict]) -> tuple[list[dict], int, float | None, datetime | None, datetime | None]:
    intervals = [
        (
            task["_start_dt"],
            task["_end_dt"],
            task["alloc_cpus"] or 0,
            task["allocated_memory_gib"] or task["requested_memory_gib"] or 0.0,
        )
        for task in tasks
        if task["_start_dt"] is not None
        and task["_end_dt"] is not None
        and task["_end_dt"] >= task["_start_dt"]
    ]
    if not intervals:
        return [], 0, None, None, None
    first = min(start for start, _, _, _ in intervals)
    last = max(end for _, end, _, _ in intervals)
    events: dict[datetime, dict[str, float]] = {}
    for start, end, cpus, memory_gib in intervals:
        start_event = events.setdefault(
            start, {"started": 0, "ended": 0, "cpus": 0, "memory_gib": 0.0}
        )
        end_event = events.setdefault(
            end, {"started": 0, "ended": 0, "cpus": 0, "memory_gib": 0.0}
        )
        start_event["started"] += 1
        start_event["cpus"] += cpus
        start_event["memory_gib"] += memory_gib
        end_event["ended"] += 1
        end_event["cpus"] -= cpus
        end_event["memory_gib"] -= memory_gib
    active = 0
    active_cpus = 0
    active_memory_gib = 0.0
    finished = 0
    peak = 0
    rows = []
    for timestamp in sorted(events):
        counts = events[timestamp]
        active -= int(counts["ended"])
        finished += int(counts["ended"])
        active += int(counts["started"])
        active_cpus += int(counts["cpus"])
        active_memory_gib += float(counts["memory_gib"])
        peak = max(peak, active)
        rows.append(
            {
                "timestamp": timestamp.isoformat(sep=" "),
                "elapsed_seconds": (timestamp - first).total_seconds(),
                "active_jobs": active,
                "allocated_cpus": active_cpus,
                "allocated_memory_gib": active_memory_gib,
                "finished_jobs": finished,
                "started_jobs": int(counts["started"]),
                "ended_jobs": int(counts["ended"]),
            }
        )
    wall = (last - first).total_seconds()
    total_job_seconds = sum((end - start).total_seconds() for start, end, _, _ in intervals)
    average_active = total_job_seconds / wall if wall > 0 else float(len(intervals))
    return rows, peak, average_active, first, last


def stats(values: list[float]) -> dict[str, float | None]:
    return {
        "minimum": min(values) if values else None,
        "mean": mean(values) if values else None,
        "p50": percentile(values, 0.50),
        "p95": percentile(values, 0.95),
        "maximum": max(values) if values else None,
    }


def ratio(numerator: float | None, denominator: float | None) -> float | None:
    return numerator / denominator if numerator is not None and denominator else None


def concurrency_timing(profile: list[dict], target: int | None) -> dict[str, float | None]:
    result = {
        "time_to_50_percent_target_seconds": None,
        "time_to_90_percent_target_seconds": None,
        "time_at_or_above_90_percent_target_seconds": None,
        "fraction_of_execution_at_or_above_90_percent_target": None,
    }
    if not profile or not target:
        return result
    first_elapsed = float(profile[0]["elapsed_seconds"])
    last_elapsed = float(profile[-1]["elapsed_seconds"])
    for fraction, key in (
        (0.5, "time_to_50_percent_target_seconds"),
        (0.9, "time_to_90_percent_target_seconds"),
    ):
        match = next(
            (row for row in profile if int(row["active_jobs"]) >= fraction * target),
            None,
        )
        if match is not None:
            result[key] = float(match["elapsed_seconds"]) - first_elapsed
    above_seconds = 0.0
    for current, following in zip(profile, profile[1:]):
        if int(current["active_jobs"]) >= 0.9 * target:
            above_seconds += float(following["elapsed_seconds"]) - float(current["elapsed_seconds"])
    wall = last_elapsed - first_elapsed
    result["time_at_or_above_90_percent_target_seconds"] = above_seconds
    result["fraction_of_execution_at_or_above_90_percent_target"] = (
        above_seconds / wall if wall > 0 else None
    )
    return result


CLUSTER_PROFILE_FIELDS = [
    "timestamp",
    "elapsed_seconds",
    "external_running_jobs",
    "external_allocated_cpus",
    "external_allocated_memory_gib",
]


def build_cluster_context(
    rows: list[dict[str, str]],
    target_job_ids: set[str],
    window_start: datetime,
    window_end: datetime,
) -> tuple[list[dict], dict]:
    events: dict[datetime, dict[str, float]] = {}
    external_jobs = []
    accounts = Counter()
    users = Counter()
    for row in select_all_logical_rows(rows):
        if row["JobID"] in target_job_ids:
            continue
        start = parse_datetime(row["Start"])
        end = parse_datetime(row["End"]) or window_end
        if start is None or end <= window_start or start >= window_end:
            continue
        start = max(start, window_start)
        end = min(end, window_end)
        if end <= start:
            continue
        cpus = parse_int(row["AllocCPUS"]) or 0
        node_count = parse_int(row["NNodes"])
        memory_kib = allocated_memory_kib(row["AllocTRES"])
        if memory_kib is None:
            memory_kib = requested_memory_kib(row["ReqMem"], cpus, node_count)
        memory_gib = memory_kib / 1024**2 if memory_kib is not None else 0.0
        events.setdefault(start, {"jobs": 0, "cpus": 0, "memory_gib": 0.0})
        events.setdefault(end, {"jobs": 0, "cpus": 0, "memory_gib": 0.0})
        events[start]["jobs"] += 1
        events[start]["cpus"] += cpus
        events[start]["memory_gib"] += memory_gib
        events[end]["jobs"] -= 1
        events[end]["cpus"] -= cpus
        events[end]["memory_gib"] -= memory_gib
        elapsed = (end - start).total_seconds()
        external_jobs.append((elapsed, cpus, memory_gib))
        if row["Account"]:
            accounts[row["Account"]] += 1
        if row["User"]:
            users[row["User"]] += 1

    active_jobs = 0
    active_cpus = 0
    active_memory = 0.0
    profile = []
    for timestamp in sorted(events):
        delta = events[timestamp]
        active_jobs += int(delta["jobs"])
        active_cpus += int(delta["cpus"])
        active_memory += float(delta["memory_gib"])
        profile.append(
            {
                "timestamp": timestamp.isoformat(sep=" "),
                "elapsed_seconds": (timestamp - window_start).total_seconds(),
                "external_running_jobs": active_jobs,
                "external_allocated_cpus": active_cpus,
                "external_allocated_memory_gib": active_memory,
            }
        )

    wall = (window_end - window_start).total_seconds()
    cpu_seconds = sum(elapsed * cpus for elapsed, cpus, _ in external_jobs)
    memory_gib_seconds = sum(elapsed * memory for elapsed, _, memory in external_jobs)
    summary = {
        "available": True,
        "logical_jobs_overlapping": len(external_jobs),
        "accounts": dict(sorted(accounts.items())),
        "users": dict(sorted(users.items())),
        "peak_running_jobs": max(
            (row["external_running_jobs"] for row in profile), default=0
        ),
        "peak_allocated_cpus": max(
            (row["external_allocated_cpus"] for row in profile), default=0
        ),
        "mean_allocated_cpus": cpu_seconds / wall if wall > 0 else None,
        "peak_allocated_memory_gib": max(
            (row["external_allocated_memory_gib"] for row in profile), default=0.0
        ),
        "mean_allocated_memory_gib": memory_gib_seconds / wall if wall > 0 else None,
        "allocated_cpu_hours": cpu_seconds / 3600,
        "allocated_memory_gib_hours": memory_gib_seconds / 3600,
    }
    return profile, summary


def build_summary(
    label: str,
    requested_ids: list[str],
    expected_jobs: int | None,
    concurrency_target: int | None,
    tasks: list[dict],
    profile: list[dict],
    peak: int,
    average_active: float | None,
    first_start: datetime | None,
    last_end: datetime | None,
) -> dict:
    states = Counter(task["state"] for task in tasks)
    successful = [
        task for task in tasks if task["state"] == "COMPLETED" and task["exit_code"] == "0:0"
    ]
    starts = [task["_start_dt"] for task in tasks if task["_start_dt"] is not None]
    ends = [task["_end_dt"] for task in tasks if task["_end_dt"] is not None]
    submits = [task["_submit_dt"] for task in tasks if task["_submit_dt"] is not None]
    durations = [float(task["duration_seconds"]) for task in tasks if task["duration_seconds"] is not None]
    queue_waits = [float(task["queue_wait_seconds"]) for task in tasks if task["queue_wait_seconds"] is not None]
    eligible_waits = [
        float(task["eligible_wait_seconds"])
        for task in tasks
        if task["eligible_wait_seconds"] is not None
    ]
    pre_eligible_waits = [
        float(task["pre_eligible_wait_seconds"])
        for task in tasks
        if task["pre_eligible_wait_seconds"] is not None
    ]
    memories = [float(task["max_rss_gib"]) for task in tasks if task["max_rss_gib"] is not None]
    memory_efficiencies = [
        float(task["memory_peak_fraction_percent"])
        for task in tasks
        if task["memory_peak_fraction_percent"] is not None
    ]
    average_cpus = [
        float(task["average_cpu_used"])
        for task in tasks
        if task["average_cpu_used"] is not None
    ]
    timelimit_utilizations = [
        float(task["timelimit_utilization_percent"])
        for task in tasks
        if task["timelimit_utilization_percent"] is not None
    ]
    io_fields = (
        "ave_disk_read_gib",
        "ave_disk_write_gib",
        "max_disk_read_gib",
        "max_disk_write_gib",
    )
    io_values = {
        field: [float(task[field]) for task in tasks if task[field] is not None]
        for field in io_fields
    }
    cpu_used = sum(task["total_cpu_seconds"] or 0 for task in tasks)
    cpu_allocated = sum(
        (task["duration_seconds"] or 0) * (task["alloc_cpus"] or 0) for task in tasks
    )
    memory_allocated_gib_seconds = sum(
        (task["duration_seconds"] or 0)
        * (task["allocated_memory_gib"] or task["requested_memory_gib"] or 0)
        for task in tasks
    )
    execution_wall = (
        (last_end - first_start).total_seconds()
        if first_start is not None and last_end is not None
        else None
    )
    first_submit = min(submits) if submits else None
    submission_wall = (
        (max(ends) - first_submit).total_seconds()
        if first_submit is not None and ends
        else None
    )
    node_counts = Counter(task["node_list"] for task in tasks if task["node_list"])
    partitions = sorted({task["partition"] for task in tasks if task["partition"]})
    accounts = sorted({task["account"] for task in tasks if task["account"]})
    qos_values = sorted({task["qos"] for task in tasks if task["qos"]})
    duration_stats = stats(durations)
    concurrency_detail = concurrency_timing(profile, concurrency_target)
    return {
        "schema_version": 3,
        "generated_at_utc": datetime.now(timezone.utc).isoformat(),
        "label": label,
        "requested_job_ids": requested_ids,
        "expected_jobs": expected_jobs,
        "logical_jobs": len(tasks),
        "successful_jobs": len(successful),
        "unsuccessful_jobs": len(tasks) - len(successful),
        "missing_expected_jobs": max(0, expected_jobs - len(tasks)) if expected_jobs else 0,
        "states": dict(sorted(states.items())),
        "slurm": {"partitions": partitions, "accounts": accounts, "qos": qos_values},
        "first_submit": first_submit.isoformat() if first_submit else None,
        "first_start": min(starts).isoformat() if starts else None,
        "last_end": max(ends).isoformat() if ends else None,
        "submission_to_last_end_seconds": submission_wall,
        "first_start_to_last_end_seconds": execution_wall,
        "sum_job_elapsed_seconds": sum(durations),
        "throughput_successful_jobs_per_hour": (
            len(successful) * 3600 / execution_wall if execution_wall and execution_wall > 0 else None
        ),
        "service_rate_successful_jobs_per_job_hour": (
            len(successful) * 3600 / sum(durations) if durations and sum(durations) > 0 else None
        ),
        "concurrency": {
            "peak": peak,
            "mean": average_active,
            "target": concurrency_target,
            "peak_fraction_of_target": peak / concurrency_target if concurrency_target else None,
            "mean_fraction_of_target": average_active / concurrency_target
            if concurrency_target and average_active is not None
            else None,
            **concurrency_detail,
        },
        "duration_seconds": {
            **duration_stats,
            "p95_to_p50_ratio": ratio(duration_stats["p95"], duration_stats["p50"]),
            "maximum_to_p50_ratio": ratio(duration_stats["maximum"], duration_stats["p50"]),
        },
        "queue_wait_seconds": stats(queue_waits),
        "pre_eligible_wait_seconds": stats(pre_eligible_waits),
        "eligible_wait_seconds": stats(eligible_waits),
        "max_rss_gib": stats(memories),
        "memory_peak_fraction_percent": stats(memory_efficiencies),
        "timelimit_utilization_percent": stats(timelimit_utilizations),
        "io": {
            "jobs_with_accounting": sum(
                any(task[field] is not None for field in io_fields) for task in tasks
            ),
            **{field: stats(values) for field, values in io_values.items()},
        },
        "cpu": {
            "used_seconds": cpu_used,
            "allocated_seconds": cpu_allocated,
            "efficiency_percent": 100 * cpu_used / cpu_allocated if cpu_allocated else None,
            "average_used_per_job": stats(average_cpus),
        },
        "allocation_profile": {
            "peak_cpus": max((row["allocated_cpus"] for row in profile), default=0),
            "mean_cpus": cpu_allocated / execution_wall if execution_wall else None,
            "peak_memory_gib": max(
                (row["allocated_memory_gib"] for row in profile), default=0.0
            ),
            "mean_memory_gib": (
                memory_allocated_gib_seconds / execution_wall if execution_wall else None
            ),
            "cpu_hours": cpu_allocated / 3600,
            "memory_gib_hours": memory_allocated_gib_seconds / 3600,
        },
        "nodes": {"unique_count": len(node_counts), "logical_jobs_by_node": dict(sorted(node_counts.items()))},
        "profile_points": len(profile),
    }


def fmt(value, digits: int = 2) -> str:
    if value is None:
        return "n/a"
    if isinstance(value, float):
        return f"{value:.{digits}f}"
    return str(value)


def format_seconds(value: float | None) -> str:
    if value is None:
        return "n/a"
    seconds = int(round(value))
    days, seconds = divmod(seconds, 86400)
    hours, seconds = divmod(seconds, 3600)
    minutes, seconds = divmod(seconds, 60)
    prefix = f"{days}d " if days else ""
    return f"{prefix}{hours:02d}:{minutes:02d}:{seconds:02d} ({int(round(value))} s)"


