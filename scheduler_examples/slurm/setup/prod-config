#PROD configs for pz-compute

. $HOME/.bashrc

echo 'PRODUCTION - setting environment'

export SCRIPTS="${SCRIPTS:-/scripts/$(whoami)}"
export SCRATCH="${SCRATCH:-/scratch/users/$(whoami)}"
export PZ_INSTALL_ROOT="${PZ_INSTALL_ROOT:-/scripts/$(whoami)/ondemand}"
export PZ_RUN_ROOT="${PZ_RUN_ROOT:-$SCRATCH/pz-compute-runs}"
mkdir -p "$PZ_RUN_ROOT"
cd "$PZ_RUN_ROOT"

# raise NPROC
ulimit -u 65536 2> /dev/null

if [[ -d ~app.photoz ]]
then
    source ~app.photoz/conf-pz-compute-user.sh
fi

export ENVIRONMENT="prod"
