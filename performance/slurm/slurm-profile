#!/usr/bin/env python3
"""Create inexpensive execution metrics and a time profile from Slurm accounting.

The profiler reads only ``sacct`` records. It does not open scientific input or
output files, making it suitable for production runs on shared filesystems.
"""

from __future__ import annotations

import argparse
import csv
import html
import json
import math
import os
import re
import subprocess
import sys
from collections import Counter
from datetime import datetime, timezone
from pathlib import Path
from statistics import mean


SACCT_FIELDS = (
    "JobIDRaw",
    "JobID",
    "JobName",
    "Partition",
    "Account",
    "QOS",
    "State",
    "ExitCode",
    "Submit",
    "Eligible",
    "Start",
    "End",
    "ElapsedRaw",
    "AllocCPUS",
    "CPUTimeRAW",
    "TotalCPU",
    "ReqMem",
    "MaxRSS",
    "AveDiskRead",
    "AveDiskWrite",
    "MaxDiskRead",
    "MaxDiskWrite",
    "NodeList",
)
MISSING_TIME = {"", "Unknown", "None", "N/A"}


def parse_args() -> argparse.Namespace:
    parser = argparse.ArgumentParser(
        description=(
            "Summarize Slurm jobs and write raw accounting, per-job timing, "
            "a time-profile table, JSON, a text log, and an SVG plot."
        )
    )
    parser.add_argument(
        "--job-id",
        action="append",
        default=[],
        help="Slurm job or array id; may be repeated or comma-separated.",
    )
    parser.add_argument(
        "--job-id-file",
        action="append",
        default=[],
        type=Path,
        help="Text file containing one Slurm job id per line; may be repeated.",
    )
    parser.add_argument(
        "--sacct-file",
        type=Path,
        help="Read a previously generated sacct.tsv instead of invoking sacct.",
    )
    parser.add_argument("--output-dir", required=True, type=Path)
    parser.add_argument("--label", default="slurm-production")
    parser.add_argument(
        "--expected-jobs",
        type=int,
        help="Expected total number of logical jobs.",
    )
    parser.add_argument(
        "--concurrency-target",
        type=int,
        help="Configured simultaneous-job target shown in the time profile.",
    )
    parser.add_argument(
        "--fail-on-unsuccessful",
        action="store_true",
        help="Exit nonzero after writing artifacts if jobs are missing or unsuccessful.",
    )
    args = parser.parse_args()
    if args.expected_jobs is not None and args.expected_jobs <= 0:
        parser.error("--expected-jobs must be positive")
    if args.concurrency_target is not None and args.concurrency_target <= 0:
        parser.error("--concurrency-target must be positive")
    if not args.sacct_file and not args.job_id and not args.job_id_file:
        parser.error("provide --job-id, --job-id-file, or --sacct-file")
    return args


def collect_job_ids(args: argparse.Namespace) -> list[str]:
    values: list[str] = []
    for value in args.job_id:
        values.extend(value.split(","))
    for path in args.job_id_file:
        for line in path.read_text(encoding="utf-8").splitlines():
            value = line.split("#", 1)[0].strip()
            if value:
                values.extend(value.split(","))
    clean = []
    seen = set()
    for value in values:
        value = value.strip().split(";", 1)[0]
        if not value or not re.fullmatch(r"[0-9]+(?:_[0-9]+)?", value):
            raise SystemExit(f"invalid Slurm job id: {value!r}")
        if value not in seen:
            clean.append(value)
            seen.add(value)
    return clean


def query_sacct(job_ids: list[str]) -> list[dict[str, str]]:
    rows: list[dict[str, str]] = []
    for offset in range(0, len(job_ids), 100):
        batch = job_ids[offset : offset + 100]
        cmd = [
            "sacct",
            f"--jobs={','.join(batch)}",
            "--parsable2",
            "--noheader",
            "--units=K",
            f"--format={','.join(SACCT_FIELDS)}",
        ]
        env = os.environ.copy()
        env["SLURM_BITSTR_LEN"] = "0"
        result = subprocess.run(cmd, text=True, capture_output=True, env=env)
        if result.returncode:
            raise SystemExit(
                "sacct failed:\n"
                + " ".join(cmd)
                + "\n"
                + (result.stderr.strip() or result.stdout.strip())
            )
        rows.extend(parse_sacct_lines(result.stdout.splitlines(), has_header=False))
    return rows


def parse_sacct_lines(lines: list[str], has_header: bool | None = None) -> list[dict[str, str]]:
    nonempty = [line.rstrip("\n") for line in lines if line.strip()]
    if not nonempty:
        return []
    delimiter = "|" if "|" in nonempty[0] else "\t"
    if has_header is None:
        has_header = nonempty[0].split(delimiter, 1)[0] == "JobIDRaw"
    if has_header:
        header = nonempty.pop(0).split(delimiter)
        if header and header[-1] == "":
            header.pop()
    else:
        header = list(SACCT_FIELDS)
    rows = []
    for line in nonempty:
        values = line.split(delimiter)
        if len(values) == len(header) + 1 and values[-1] == "":
            values.pop()
        if len(values) != len(header):
            raise SystemExit(
                f"invalid sacct row: expected {len(header)} fields, got {len(values)}: {line}"
            )
        row = dict(zip(header, values))
        for field in SACCT_FIELDS:
            row.setdefault(field, "")
        rows.append(row)
    return rows


def read_sacct_file(path: Path) -> list[dict[str, str]]:
    return parse_sacct_lines(path.read_text(encoding="utf-8").splitlines())


def write_tsv(path: Path, fieldnames: list[str], rows: list[dict]) -> None:
    with path.open("w", encoding="utf-8", newline="") as stream:
        writer = csv.DictWriter(stream, fieldnames=fieldnames, delimiter="\t", extrasaction="ignore")
        writer.writeheader()
        writer.writerows(rows)


def parse_datetime(value: str) -> datetime | None:
    if value in MISSING_TIME:
        return None
    try:
        return datetime.fromisoformat(value)
    except ValueError as err:
        raise SystemExit(f"invalid Slurm datetime {value!r}: {err}") from err


def parse_int(value: str) -> int | None:
    if not value:
        return None
    try:
        return int(value)
    except ValueError:
        return None


def parse_slurm_duration(value: str) -> float | None:
    if not value:
        return None
    try:
        days = 0
        rest = value
        if "-" in rest:
            day_text, rest = rest.split("-", 1)
            days = int(day_text)
        fields = rest.split(":")
        if len(fields) == 3:
            hours, minutes, seconds = fields
        elif len(fields) == 2:
            hours = "0"
            minutes, seconds = fields
        else:
            return float(value)
        return days * 86400 + int(hours) * 3600 + int(minutes) * 60 + float(seconds)
    except ValueError:
        return None


def parse_memory_kib(value: str) -> float | None:
    if not value:
        return None
    match = re.fullmatch(r"([0-9]+(?:\.[0-9]+)?)([KMGTP]?)", value.strip(), re.I)
    if not match:
        return None
    number = float(match.group(1))
    unit = match.group(2).upper()
    factor = {"": 1 / 1024, "K": 1, "M": 1024, "G": 1024**2, "T": 1024**3, "P": 1024**4}
    return number * factor[unit]


def percentile(values: list[float], fraction: float) -> float | None:
    if not values:
        return None
    ordered = sorted(values)
    if len(ordered) == 1:
        return ordered[0]
    position = fraction * (len(ordered) - 1)
    lower = math.floor(position)
    upper = math.ceil(position)
    if lower == upper:
        return ordered[lower]
    weight = position - lower
    return ordered[lower] * (1 - weight) + ordered[upper] * weight


def clean_state(value: str) -> str:
    return value.strip().split()[0].rstrip("+") if value.strip() else "UNKNOWN"


def infer_requested_ids(rows: list[dict[str, str]]) -> list[str]:
    root_ids = sorted({row["JobID"] for row in rows if "." not in row["JobID"]})
    array_parents = {
        match.group(1)
        for job_id in root_ids
        if (match := re.fullmatch(r"([0-9]+)_[0-9]+", job_id))
    }
    return [job_id for job_id in root_ids if job_id not in array_parents]


def select_logical_rows(
    rows: list[dict[str, str]], requested_ids: list[str]
) -> list[dict[str, str]]:
    by_id = {row["JobID"]: row for row in rows}
    selected: dict[str, dict[str, str]] = {}
    for requested in requested_ids:
        array_pattern = re.compile(rf"{re.escape(requested)}_[0-9]+$")
        array_rows = [row for row in rows if array_pattern.fullmatch(row["JobID"])]
        if array_rows:
            for row in array_rows:
                selected[row["JobID"]] = row
        elif requested in by_id and "." not in requested:
            selected[requested] = by_id[requested]
        else:
            raise SystemExit(f"no logical sacct record found for requested job {requested}")
    return sorted(selected.values(), key=lambda row: natural_job_key(row["JobID"]))


def natural_job_key(job_id: str) -> tuple[int, int]:
    match = re.fullmatch(r"([0-9]+)(?:_([0-9]+))?", job_id)
    if not match:
        return (sys.maxsize, sys.maxsize)
    return (int(match.group(1)), int(match.group(2) or -1))


def maximum_resource_value(
    related: list[dict[str, str]], field: str
) -> float | None:
    values = [parse_memory_kib(row[field]) for row in related]
    valid_values = [value for value in values if value is not None]
    return max(valid_values) if valid_values else None


def resource_values(logical_id: str, rows: list[dict[str, str]]) -> dict[str, float | None]:
    related = [
        row
        for row in rows
        if row["JobID"] == logical_id or row["JobID"].startswith(logical_id + ".")
    ]
    cpu_times = [parse_slurm_duration(row["TotalCPU"]) for row in related]
    valid_cpu_times = [value for value in cpu_times if value is not None]
    return {
        "max_rss_kib": maximum_resource_value(related, "MaxRSS"),
        "total_cpu_seconds": max(valid_cpu_times) if valid_cpu_times else None,
        "ave_disk_read_kib": maximum_resource_value(related, "AveDiskRead"),
        "ave_disk_write_kib": maximum_resource_value(related, "AveDiskWrite"),
        "max_disk_read_kib": maximum_resource_value(related, "MaxDiskRead"),
        "max_disk_write_kib": maximum_resource_value(related, "MaxDiskWrite"),
    }


