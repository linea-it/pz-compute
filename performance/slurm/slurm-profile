def build_tasks(logical_rows: list[dict[str, str]], all_rows: list[dict[str, str]]) -> list[dict]:
    tasks = []
    for row in logical_rows:
        job_id = row["JobID"]
        submit = parse_datetime(row["Submit"])
        eligible = parse_datetime(row["Eligible"])
        start = parse_datetime(row["Start"])
        end = parse_datetime(row["End"])
        duration = parse_int(row["ElapsedRaw"])
        if duration is None and start is not None and end is not None:
            duration = max(0, int((end - start).total_seconds()))
        alloc_cpus = parse_int(row["AllocCPUS"])
        resources = resource_values(job_id, all_rows)
        max_rss_kib = resources["max_rss_kib"]
        total_cpu = resources["total_cpu_seconds"]
        allocated_cpu_seconds = (
            duration * alloc_cpus
            if duration is not None and alloc_cpus is not None and alloc_cpus > 0
            else None
        )
        cpu_efficiency = (
            100 * total_cpu / allocated_cpu_seconds
            if total_cpu is not None and allocated_cpu_seconds
            else None
        )
        array_match = re.fullmatch(r"[0-9]+_([0-9]+)", job_id)
        tasks.append(
            {
                "job_id": job_id,
                "job_id_raw": row["JobIDRaw"],
                "array_task_id": int(array_match.group(1)) if array_match else "",
                "job_name": row["JobName"],
                "partition": row["Partition"],
                "account": row["Account"],
                "qos": row["QOS"],
                "state": clean_state(row["State"]),
                "exit_code": row["ExitCode"],
                "submit": row["Submit"],
                "eligible": row["Eligible"],
                "start": row["Start"],
                "end": row["End"],
                "queue_wait_seconds": (
                    (start - submit).total_seconds() if start is not None and submit is not None else None
                ),
                "eligible_wait_seconds": (
                    (start - eligible).total_seconds()
                    if start is not None and eligible is not None
                    else None
                ),
                "duration_seconds": duration,
                "req_mem": row["ReqMem"],
                "alloc_cpus": alloc_cpus,
                "total_cpu_seconds": total_cpu,
                "cpu_efficiency_percent": cpu_efficiency,
                "max_rss_kib": max_rss_kib,
                "max_rss_gib": max_rss_kib / 1024**2 if max_rss_kib is not None else None,
                "ave_disk_read_kib": resources["ave_disk_read_kib"],
                "ave_disk_read_gib": (
                    resources["ave_disk_read_kib"] / 1024**2
                    if resources["ave_disk_read_kib"] is not None
                    else None
                ),
                "ave_disk_write_kib": resources["ave_disk_write_kib"],
                "ave_disk_write_gib": (
                    resources["ave_disk_write_kib"] / 1024**2
                    if resources["ave_disk_write_kib"] is not None
                    else None
                ),
                "max_disk_read_kib": resources["max_disk_read_kib"],
                "max_disk_read_gib": (
                    resources["max_disk_read_kib"] / 1024**2
                    if resources["max_disk_read_kib"] is not None
                    else None
                ),
                "max_disk_write_kib": resources["max_disk_write_kib"],
                "max_disk_write_gib": (
                    resources["max_disk_write_kib"] / 1024**2
                    if resources["max_disk_write_kib"] is not None
                    else None
                ),
                "node_list": row["NodeList"],
                "_submit_dt": submit,
                "_start_dt": start,
                "_end_dt": end,
            }
        )
    return tasks


def build_profile(tasks: list[dict]) -> tuple[list[dict], int, float | None, datetime | None, datetime | None]:
    intervals = [
        (task["_start_dt"], task["_end_dt"])
        for task in tasks
        if task["_start_dt"] is not None
        and task["_end_dt"] is not None
        and task["_end_dt"] >= task["_start_dt"]
    ]
    if not intervals:
        return [], 0, None, None, None
    first = min(start for start, _ in intervals)
    last = max(end for _, end in intervals)
    events: dict[datetime, dict[str, int]] = {}
    for start, end in intervals:
        events.setdefault(start, {"started": 0, "ended": 0})["started"] += 1
        events.setdefault(end, {"started": 0, "ended": 0})["ended"] += 1
    active = 0
    finished = 0
    peak = 0
    rows = []
    for timestamp in sorted(events):
        counts = events[timestamp]
        active -= counts["ended"]
        finished += counts["ended"]
        active += counts["started"]
        peak = max(peak, active)
        rows.append(
            {
                "timestamp": timestamp.isoformat(sep=" "),
                "elapsed_seconds": (timestamp - first).total_seconds(),
                "active_jobs": active,
                "finished_jobs": finished,
                "started_jobs": counts["started"],
                "ended_jobs": counts["ended"],
            }
        )
    wall = (last - first).total_seconds()
    total_job_seconds = sum((end - start).total_seconds() for start, end in intervals)
    average_active = total_job_seconds / wall if wall > 0 else float(len(intervals))
    return rows, peak, average_active, first, last


def stats(values: list[float]) -> dict[str, float | None]:
    return {
        "minimum": min(values) if values else None,
        "mean": mean(values) if values else None,
        "p50": percentile(values, 0.50),
        "p95": percentile(values, 0.95),
        "maximum": max(values) if values else None,
    }


def build_summary(
    label: str,
    requested_ids: list[str],
    expected_jobs: int | None,
    concurrency_target: int | None,
    tasks: list[dict],
    profile: list[dict],
    peak: int,
    average_active: float | None,
    first_start: datetime | None,
    last_end: datetime | None,
) -> dict:
    states = Counter(task["state"] for task in tasks)
    successful = [
        task for task in tasks if task["state"] == "COMPLETED" and task["exit_code"] == "0:0"
    ]
    starts = [task["_start_dt"] for task in tasks if task["_start_dt"] is not None]
    ends = [task["_end_dt"] for task in tasks if task["_end_dt"] is not None]
    submits = [task["_submit_dt"] for task in tasks if task["_submit_dt"] is not None]
    durations = [float(task["duration_seconds"]) for task in tasks if task["duration_seconds"] is not None]
    queue_waits = [float(task["queue_wait_seconds"]) for task in tasks if task["queue_wait_seconds"] is not None]
    eligible_waits = [
        float(task["eligible_wait_seconds"])
        for task in tasks
        if task["eligible_wait_seconds"] is not None
    ]
    memories = [float(task["max_rss_gib"]) for task in tasks if task["max_rss_gib"] is not None]
    io_fields = (
        "ave_disk_read_gib",
        "ave_disk_write_gib",
        "max_disk_read_gib",
        "max_disk_write_gib",
    )
    io_values = {
        field: [float(task[field]) for task in tasks if task[field] is not None]
        for field in io_fields
    }
    cpu_used = sum(task["total_cpu_seconds"] or 0 for task in tasks)
    cpu_allocated = sum(
        (task["duration_seconds"] or 0) * (task["alloc_cpus"] or 0) for task in tasks
    )
    execution_wall = (
        (last_end - first_start).total_seconds()
        if first_start is not None and last_end is not None
        else None
    )
    first_submit = min(submits) if submits else None
    submission_wall = (
        (max(ends) - first_submit).total_seconds()
        if first_submit is not None and ends
        else None
    )
    node_counts = Counter(task["node_list"] for task in tasks if task["node_list"])
    partitions = sorted({task["partition"] for task in tasks if task["partition"]})
    accounts = sorted({task["account"] for task in tasks if task["account"]})
    qos_values = sorted({task["qos"] for task in tasks if task["qos"]})
    return {
        "schema_version": 2,
        "generated_at_utc": datetime.now(timezone.utc).isoformat(),
        "label": label,
        "requested_job_ids": requested_ids,
        "expected_jobs": expected_jobs,
        "logical_jobs": len(tasks),
        "successful_jobs": len(successful),
        "unsuccessful_jobs": len(tasks) - len(successful),
        "missing_expected_jobs": max(0, expected_jobs - len(tasks)) if expected_jobs else 0,
        "states": dict(sorted(states.items())),
        "slurm": {"partitions": partitions, "accounts": accounts, "qos": qos_values},
        "first_submit": first_submit.isoformat() if first_submit else None,
        "first_start": min(starts).isoformat() if starts else None,
        "last_end": max(ends).isoformat() if ends else None,
        "submission_to_last_end_seconds": submission_wall,
        "first_start_to_last_end_seconds": execution_wall,
        "sum_job_elapsed_seconds": sum(durations),
        "throughput_successful_jobs_per_hour": (
            len(successful) * 3600 / execution_wall if execution_wall and execution_wall > 0 else None
        ),
        "concurrency": {
            "peak": peak,
            "mean": average_active,
            "target": concurrency_target,
            "peak_fraction_of_target": peak / concurrency_target if concurrency_target else None,
            "mean_fraction_of_target": average_active / concurrency_target
            if concurrency_target and average_active is not None
            else None,
        },
        "duration_seconds": stats(durations),
        "queue_wait_seconds": stats(queue_waits),
        "eligible_wait_seconds": stats(eligible_waits),
        "max_rss_gib": stats(memories),
        "io": {
            "jobs_with_accounting": sum(
                any(task[field] is not None for field in io_fields) for task in tasks
            ),
            **{field: stats(values) for field, values in io_values.items()},
        },
        "cpu": {
            "used_seconds": cpu_used,
            "allocated_seconds": cpu_allocated,
            "efficiency_percent": 100 * cpu_used / cpu_allocated if cpu_allocated else None,
        },
        "nodes": {"unique_count": len(node_counts), "logical_jobs_by_node": dict(sorted(node_counts.items()))},
        "profile_points": len(profile),
    }


def fmt(value, digits: int = 2) -> str:
    if value is None:
        return "n/a"
    if isinstance(value, float):
        return f"{value:.{digits}f}"
    return str(value)


def format_seconds(value: float | None) -> str:
    if value is None:
        return "n/a"
    seconds = int(round(value))
    days, seconds = divmod(seconds, 86400)
    hours, seconds = divmod(seconds, 3600)
    minutes, seconds = divmod(seconds, 60)
    prefix = f"{days}d " if days else ""
    return f"{prefix}{hours:02d}:{minutes:02d}:{seconds:02d} ({int(round(value))} s)"


def write_summary_log(path: Path, summary: dict) -> None:
    duration = summary["duration_seconds"]
    queue = summary["queue_wait_seconds"]
    rss = summary["max_rss_gib"]
    concurrency = summary["concurrency"]
    cpu = summary["cpu"]
    io = summary["io"]
    lines = [
        f"label: {summary['label']}",
        f"generated_at_utc: {summary['generated_at_utc']}",
        f"requested_job_ids: {', '.join(summary['requested_job_ids']) or 'inferred'}",
        f"expected_jobs: {fmt(summary['expected_jobs'])}",
        f"logical_jobs: {summary['logical_jobs']}",
        f"successful_jobs: {summary['successful_jobs']}",
        f"unsuccessful_jobs: {summary['unsuccessful_jobs']}",
        f"missing_expected_jobs: {summary['missing_expected_jobs']}",
        "states: " + ", ".join(f"{key}={value}" for key, value in summary["states"].items()),
        f"partitions: {', '.join(summary['slurm']['partitions']) or 'n/a'}",
        f"accounts: {', '.join(summary['slurm']['accounts']) or 'n/a'}",
        f"qos: {', '.join(summary['slurm']['qos']) or 'n/a'}",
        f"first_submit: {summary['first_submit']}",
        f"first_start: {summary['first_start']}",
        f"last_end: {summary['last_end']}",
        "submission_to_last_end: " + format_seconds(summary["submission_to_last_end_seconds"]),
        "first_start_to_last_end: " + format_seconds(summary["first_start_to_last_end_seconds"]),
        "sum_job_elapsed: " + format_seconds(summary["sum_job_elapsed_seconds"]),
        f"throughput_successful_jobs_per_hour: {fmt(summary['throughput_successful_jobs_per_hour'])}",
        f"concurrency_peak: {concurrency['peak']}",
        f"concurrency_mean: {fmt(concurrency['mean'])}",
        f"concurrency_target: {fmt(concurrency['target'])}",
        f"concurrency_peak_fraction_of_target: {fmt(concurrency['peak_fraction_of_target'])}",
        f"concurrency_mean_fraction_of_target: {fmt(concurrency['mean_fraction_of_target'])}",
        f"duration_seconds_p50_p95_max: {fmt(duration['p50'])}, {fmt(duration['p95'])}, {fmt(duration['maximum'])}",
        f"queue_wait_seconds_p50_p95_max: {fmt(queue['p50'])}, {fmt(queue['p95'])}, {fmt(queue['maximum'])}",
        f"max_rss_gib_p50_p95_max: {fmt(rss['p50'])}, {fmt(rss['p95'])}, {fmt(rss['maximum'])}",
        f"io_jobs_with_accounting: {io['jobs_with_accounting']}",
        "io_ave_disk_read_gib_p50_p95_max: "
        + f"{fmt(io['ave_disk_read_gib']['p50'])}, {fmt(io['ave_disk_read_gib']['p95'])}, "
        + fmt(io["ave_disk_read_gib"]["maximum"]),
        "io_ave_disk_write_gib_p50_p95_max: "
        + f"{fmt(io['ave_disk_write_gib']['p50'])}, {fmt(io['ave_disk_write_gib']['p95'])}, "
        + fmt(io["ave_disk_write_gib"]["maximum"]),
        "io_max_disk_read_gib_p50_p95_max: "
        + f"{fmt(io['max_disk_read_gib']['p50'])}, {fmt(io['max_disk_read_gib']['p95'])}, "
        + fmt(io["max_disk_read_gib"]["maximum"]),
        "io_max_disk_write_gib_p50_p95_max: "
        + f"{fmt(io['max_disk_write_gib']['p50'])}, {fmt(io['max_disk_write_gib']['p95'])}, "
        + fmt(io["max_disk_write_gib"]["maximum"]),
        f"cpu_used_seconds: {fmt(cpu['used_seconds'])}",
        f"cpu_allocated_seconds: {fmt(cpu['allocated_seconds'])}",
        f"cpu_efficiency_percent: {fmt(cpu['efficiency_percent'])}",
        f"unique_nodes: {summary['nodes']['unique_count']}",
        "logical_jobs_by_node: "
        + ", ".join(
            f"{key}={value}" for key, value in summary["nodes"]["logical_jobs_by_node"].items()
        ),
    ]
    path.write_text("\n".join(lines) + "\n", encoding="utf-8")


def svg_polyline(points: list[tuple[float, float]], color: str, width: int = 3) -> str:
    encoded = " ".join(f"{x:.2f},{y:.2f}" for x, y in points)
    return f'<polyline fill="none" stroke="{color}" stroke-width="{width}" points="{encoded}"/>'


def write_svg(
    path: Path, label: str, profile: list[dict], concurrency_target: int | None
) -> None:
    width, height = 1200, 760
    left, right = 100, 1150
    top1, bottom1 = 100, 350
    top2, bottom2 = 455, 705
    x_max = max((float(row["elapsed_seconds"]) for row in profile), default=1.0) or 1.0
    active_max = max((int(row["active_jobs"]) for row in profile), default=1)
    finished_max = max((int(row["finished_jobs"]) for row in profile), default=1)
    y1_max = max(1, active_max, concurrency_target or 0)
    y2_max = max(1, finished_max)

    def x(value: float) -> float:
        return left + value / x_max * (right - left)

    def y1(value: float) -> float:
        return bottom1 - value / y1_max * (bottom1 - top1)

    def y2(value: float) -> float:
        return bottom2 - value / y2_max * (bottom2 - top2)

    active_points = [(x(0), y1(0))]
    completed_points = [(x(0), y2(0))]
    previous_active = 0
    previous_completed = 0
    for row in profile:
        xpos = x(float(row["elapsed_seconds"]))
        active_points.extend([(xpos, y1(previous_active)), (xpos, y1(int(row["active_jobs"])))])
        completed_points.extend(
            [(xpos, y2(previous_completed)), (xpos, y2(int(row["finished_jobs"])))]
        )
        previous_active = int(row["active_jobs"])
        previous_completed = int(row["finished_jobs"])

    elements = [
        f'<svg xmlns="http://www.w3.org/2000/svg" width="{width}" height="{height}" viewBox="0 0 {width} {height}">',
        '<rect width="100%" height="100%" fill="white"/>',
        '<style>text{font-family:DejaVu Sans,Arial,sans-serif;fill:#222}.grid{stroke:#ddd;stroke-width:1}.axis{stroke:#333;stroke-width:1.5}</style>',
        f'<text x="{width/2}" y="38" text-anchor="middle" font-size="24">{html.escape(label)} — Slurm time profile</text>',
    ]
    for plot_top, plot_bottom, ymax, title in (
        (top1, bottom1, y1_max, "Active jobs"),
        (top2, bottom2, y2_max, "Finished jobs"),
    ):
        for fraction in (0, 0.25, 0.5, 0.75, 1):
            ypos = plot_bottom - fraction * (plot_bottom - plot_top)
            value = fraction * ymax
            elements.append(f'<line class="grid" x1="{left}" y1="{ypos}" x2="{right}" y2="{ypos}"/>')
            elements.append(f'<text x="{left-12}" y="{ypos+5}" text-anchor="end" font-size="13">{value:.0f}</text>')
        elements.append(f'<line class="axis" x1="{left}" y1="{plot_top}" x2="{left}" y2="{plot_bottom}"/>')
        elements.append(f'<line class="axis" x1="{left}" y1="{plot_bottom}" x2="{right}" y2="{plot_bottom}"/>')
        elements.append(f'<text x="{left}" y="{plot_top-15}" font-size="17">{title}</text>')
    for fraction in (0, 0.25, 0.5, 0.75, 1):
        xpos = left + fraction * (right - left)
        hours = fraction * x_max / 3600
        for plot_top, plot_bottom in ((top1, bottom1), (top2, bottom2)):
            elements.append(f'<line class="grid" x1="{xpos}" y1="{plot_top}" x2="{xpos}" y2="{plot_bottom}"/>')
        elements.append(f'<text x="{xpos}" y="{bottom2+25}" text-anchor="middle" font-size="13">{hours:.2f}</text>')
    if concurrency_target:
        elements.append(f'<line x1="{left}" y1="{y1(concurrency_target)}" x2="{right}" y2="{y1(concurrency_target)}" stroke="#d62728" stroke-width="2" stroke-dasharray="8,6"/>')
        elements.append(f'<text x="{right-5}" y="{y1(concurrency_target)-8}" text-anchor="end" font-size="13" fill="#d62728">target {concurrency_target}</text>')
    if active_points:
        elements.append(svg_polyline(active_points, "#0072B2"))
    if completed_points:
        elements.append(svg_polyline(completed_points, "#009E73"))
    elements.append(f'<text x="{(left+right)/2}" y="{height-15}" text-anchor="middle" font-size="15">Elapsed time since first job start (hours)</text>')
    elements.append("</svg>")
    path.write_text("\n".join(elements) + "\n", encoding="utf-8")


def main() -> int:
    args = parse_args()
    requested_ids = collect_job_ids(args)
    if args.sacct_file:
        rows = read_sacct_file(args.sacct_file)
        if not requested_ids:
            requested_ids = infer_requested_ids(rows)
    else:
        rows = query_sacct(requested_ids)
    if not rows:
        raise SystemExit("sacct returned no records")

    args.output_dir.mkdir(parents=True, exist_ok=True)
    write_tsv(args.output_dir / "sacct.tsv", list(SACCT_FIELDS), rows)
    logical_rows = select_logical_rows(rows, requested_ids)
    tasks = build_tasks(logical_rows, rows)
    profile, peak, average_active, first_start, last_end = build_profile(tasks)
    summary = build_summary(
        args.label,
        requested_ids,
        args.expected_jobs,
        args.concurrency_target,
        tasks,
        profile,
        peak,
        average_active,
        first_start,
        last_end,
    )

    serializable_tasks = [{key: task.get(key) for key in TASK_FIELDS} for task in tasks]
    write_tsv(args.output_dir / "tasks.tsv", TASK_FIELDS, serializable_tasks)
    write_tsv(
        args.output_dir / "time-profile.tsv",
        ["timestamp", "elapsed_seconds", "active_jobs", "finished_jobs", "started_jobs", "ended_jobs"],
        profile,
    )
    (args.output_dir / "summary.json").write_text(
        json.dumps(summary, indent=2, sort_keys=True) + "\n", encoding="utf-8"
    )
    write_summary_log(args.output_dir / "summary.log", summary)
    write_svg(
        args.output_dir / "time-profile.svg",
        args.label,
        profile,
        args.concurrency_target,
    )

    print((args.output_dir / "summary.log").read_text(encoding="utf-8"), end="")
    print(f"artifacts: {args.output_dir}")

    unsuccessful = summary["unsuccessful_jobs"] > 0 or summary["missing_expected_jobs"] > 0
    return 2 if args.fail_on_unsuccessful and unsuccessful else 0


if __name__ == "__main__":
    raise SystemExit(main())
