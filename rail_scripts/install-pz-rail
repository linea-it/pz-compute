#!/bin/bash
set -eo pipefail

# This script assumes that the target conda environment is already active.
conda --version

if [ -z "${CONDA_PREFIX:-}" ]; then
    echo "Error: no active conda environment detected."
    echo "Activate the target environment before running this script."
    exit 1
fi

if [ "${CONDA_DEFAULT_ENV:-}" = "base" ]; then
    echo "Error: the active environment is 'base'."
    echo "Activate a dedicated environment before installing RAIL."
    exit 1
fi

# Keep installation caches and small support files under /scripts.
PZ_INSTALL_ROOT="${PZ_INSTALL_ROOT:-/scripts/$(whoami)/ondemand}"

if [ -z "${CONDA_PKGS_DIRS:-}" ]; then
    export CONDA_PKGS_DIRS="${PZ_INSTALL_ROOT}/conda_pkgs"
fi

if [ -z "${PIP_CACHE_DIR:-}" ]; then
    export PIP_CACHE_DIR="${PZ_INSTALL_ROOT}/pip_cache"
fi

IFS=':' read -r -a conda_pkg_dirs <<< "$CONDA_PKGS_DIRS"
for conda_pkg_dir in "${conda_pkg_dirs[@]}"; do
    mkdir -p "$conda_pkg_dir"
done
mkdir -p "$PIP_CACHE_DIR"

echo "The following conda environment is active: ${CONDA_PREFIX}"
echo "PZ install root: ${PZ_INSTALL_ROOT}"
echo "Conda package cache: ${CONDA_PKGS_DIRS}"
echo "Pip package cache: ${PIP_CACHE_DIR}"
read -r -p "Type yes to confirm installing RAIL in this environment: " input

if [ "$input" != "yes" ]; then
    echo "Exiting..."
    exit 1
fi

set -x

conda install -y -c conda-forge \
    h5py \
    pyyaml \
    pandas \
    matplotlib \
    psutil \
    cython \
    mpi4py \
    numexpr \
    pyviz_comms \
    dask \
    distributed \
    dask-jobqueue \
    joblib \
    scikit-learn \
    scikit-learn-intelex \
    fitsio \
    pytdigest \
    scipy \
    docopt \
    pyxdg \
    pip

pip install \
    pz-rail \
    pz-rail-bpz \
    pz-rail-flexzboost \
    pz-rail-tpz \
    pz-rail-gpz-v1 \
    pz-rail-lephare \
    flexcode
