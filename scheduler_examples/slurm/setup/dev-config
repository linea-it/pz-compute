#DEVELOPMENT env for pz-compute

. $HOME/.bashrc

echo "DEV - setting environment"

cd $SCRIPTS

if [ -d "pz-compute" ] || [ -L "pz-compute" ]; then
  echo "pz-compute dir ok"
else
  echo "pz-compute dir does not exist, please clone or link it"
  exit 1
fi

if conda info --envs | grep -q pz_compute_dev; then 
  conda activate pz_compute_dev
  echo "pz_compute_dev env already exists (: activating it" 

  read -p "Would you like to reinstall pz_compute package? (y/n):" resposta

  if [[ "$resposta" == "y" || "$resposta" == "Y" ]]; then
    $SCRIPTS/pz-compute/rail_scripts/install-pz-rail
  fi

  export PATH=$PATH:$SCRIPTS/bin
  export DUSTMAPS_CONFIG_FNAME=$SCRIPTS/pz-compute/rail_scripts/dustmaps_config.json
  export PATH=$PATH:$SCRIPTS/pz-compute/scheduler_examples/slurm

  chmod +x $SCRIPTS/bin/pz_run_setup_dev.py
else 
  echo "pz_compute_dev env does not exist ): creating it"
  
  conda create --name pz_compute_dev python=3.11
fi

conda activate pz_compute_dev 

mkdir $SCRIPTS/bin
ln -s $SCRIPTS/pz-compute/scheduler_scripts/slurm/pz-compute $SCRIPTS/bin/pz-compute-dev
chmod +x $SCRIPTS/bin/pz-compute-dev

ln -s $SCRIPTS/pz-compute/scheduler_scripts/slurm/pz-train $SCRIPTS/bin/pz-train-dev
chmod +x $SCRIPTS/bin/pz-train-dev

export PATH=$PATH:$SCRIPTS/bin
export DUSTMAPS_CONFIG_FNAME=$SCRIPTS/pz-compute/rail_scripts/dustmaps_config.json

mkdir -p $ALTHOME/data
$SCRIPTS/pz-compute/rail_scripts/install-pz-rail

ln -s $SCRIPTS/pz-compute/scheduler_examples/slurm/setup/pz_run_setup.py $SCRIPTS/bin/pz_run_setup_dev.py
chmod +x $SCRIPTS/bin/pz_run_setup_dev.py

ln -s $SCRIPTS/pz-compute/performance/slurm/slurm-analyze-host-performance.py $SCRIPTS/bin/slurm-analyze-host-performance.py
chmod +x $SCRIPTS/bin/slurm-analyze-host-performance.py

ln -s  $SCRIPTS/pz-compute/rail_scripts/rail-estimate $SCRIPTS/bin/rail-estimate
ln -s  $SCRIPTS/pz-compute/rail_scripts/rail-train $SCRIPTS/bin/rail-train 
ln -s  $SCRIPTS/pz-compute/rail_scripts/rail-preprocess-parquet $SCRIPTS/bin/rail-preprocess-parquet 

echo "installing other dependencies"

conda install -y jupyter_bokeh
conda install -y ipykernel
conda install -y bokeh
conda install -y holoviews

pip install -e $SCRIPTS/pz-compute/ondemand/ondemand_utils/.
#pip install pzserver


export ENVIRONMENT="dev"

