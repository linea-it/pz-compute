#!/usr/bin/env python3
"""Create inexpensive execution metrics and a time profile from Slurm accounting.

The profiler reads only ``sacct`` records. It does not open scientific input or
output files, making it suitable for production runs on shared filesystems.
"""

from __future__ import annotations

import argparse
import csv
import html
import json
import math
import os
import re
import subprocess
import sys
from collections import Counter
from datetime import datetime, timezone
from pathlib import Path
from statistics import mean


